{
  "colors": {
    "logo-red": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          0.0,
          0.0
        ],
        "alpha": 1,
        "hex": "#FF0000"
      }
    },
    "logo-blue": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0,
