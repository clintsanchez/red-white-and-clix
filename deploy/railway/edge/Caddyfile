{
	# Railway terminates TLS at its edge and routes plain HTTP to the container.
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	# NOTHING is gated at the edge as of 2026-09-25.
	#
	# Basic auth here could not coexist with the work: Instatic's write tools
	# drive through a signed-in browser workspace whose socket only lives while
	# the tab has focus, and the edge challenge blocked holding that session
	# from an automated browser. The gate was costing more than it protected on
	# a pre-launch site.
	#
	# What still protects /admin: Instatic's own login, which locks an account
	# out after 5 failed attempts with the window doubling up to 24 hours. The
	# staging URL is unlisted and carries canonical tags pointing at the real
	# domain, so it should not be indexed.
	#
	# AT LAUNCH: do not simply re-add this. Stop exposing staging publicly once
	# the site is on redwhiteandclix.org. See LAUNCH-DOMAIN-SWITCH.md.

	# Everything below runs in written order. Instatic serves neither
	# robots.txt nor sitemap.xml (both 404), so the edge supplies them.
	route {
		# Staging must never be indexed. It is publicly reachable and serves
		# the same content as production, so without this it competes with
		# the real domain. Host-specific, so production is unaffected.
		@staging_robots {
			host site-production-0334.up.railway.app
			path /robots.txt
		}
		respond @staging_robots 200 {
			body "User-agent: *
Disallow: /
"
		}

		@robots path /robots.txt
		respond @robots 200 {
			body "User-agent: *
Allow: /
Disallow: /admin

Sitemap: https://www.redwhiteandclix.org/sitemap.xml
"
		}

		# The store moved to shop.redwhiteandclix.org when that subdomain
		# became the Squarespace site's primary domain. Product URLs under
		# /shop/p/ on this host 404, and they are linked from the /shop page
		# AND indexed from the Squarespace era. Redirect rather than only
		# fixing the on-page links, so old inbound links survive too.
		#
		# /shop itself is a real Instatic page and must NOT be caught here.
		@storeproduct path /shop/p/*
		redir @storeproduct https://shop.redwhiteandclix.org{uri} permanent

		# Form confirmation pages exist only to confirm a submission (and to be
		# GA4's conversion page views). Keep them out of search at the header
		# level too, so they stay hidden even if the page's meta tag is lost.
		@thanks path /thank-you /thank-you/*
		header @thanks X-Robots-Tag "noindex, nofollow"

		# Website forms -> the `forms` service (deploy/railway/forms), which
		# upserts the contact into GoHighLevel. Private network only; the GHL
		# key lives on that service, never in this public repository.
		@forms path /api/forms/*
		handle @forms {
			reverse_proxy {$FORMS_UPSTREAM:forms.railway.internal:8080} {
				# {remote_host} is Railway's proxy, not the visitor, so forward the
				# client address Railway supplies; the service rate-limits on it.
				header_up X-Real-IP {http.request.header.X-Real-IP}
				header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			}
		}

		# Static file baked into the image; see srv/sitemap.xml for why it is
		# not generated.
		@sitemap path /sitemap.xml
		handle @sitemap {
			root * /srv
			header Content-Type "application/xml; charset=utf-8"
			file_server
		}

		reverse_proxy {$UPSTREAM} {
			# Instatic builds absolute URLs and checks request origin, so it
			# needs to see the public scheme rather than the plain HTTP hop
			# from Railway.
			header_up X-Forwarded-Proto https

			# Instatic answers an unknown path with 21 bytes of JSON:
			# {"error":"Not found"}. A visitor who mistypes a URL, or follows
			# one of the old Squarespace links, gets raw JSON with no way back
			# to the site. Swap the body for a real page and keep the 404.
			# Hand upstream 404s to Caddy's own error handling rather than
			# rendering the page here. Serving the file inside handle_response
			# answers 200, which turns the error page into a soft 404 that
			# Google indexes; going through handle_errors keeps the 404.
			@notfound status 404
			handle_response @notfound {
				error 404
			}
		}
	}

	encode gzip

	# Instatic answers an unknown path with 21 bytes of JSON:
	# {"error":"Not found"}. A visitor who mistypes a URL, or follows one of
	# the old Squarespace links, would get raw JSON and no way back.
	handle_errors {
		root * /srv
		rewrite * /404.html
		header Content-Type "text/html; charset=utf-8"
		file_server
	}
}
